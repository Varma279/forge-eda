# ==========================================
# 1. Python & Packaging
# ==========================================
# Python bytecode cache directories
__pycache__/
# Compiled Python files (.pyc, .pyo, .pyd)
*.py[cod]
# Jython compiled class files
*$py.class
# Compiled C/C++ shared object extensions
*.so
# Package metadata generated by setuptools/pip
*.egg-info/
# Distribution archives (wheels, source tarballs)
dist/
# Temporary build artifacts
build/
# Locally downloaded setuptools build dependencies
.eggs/
# Pytest cache directory
.pytest_cache/
# Mypy type-checker cache
.mypy_cache/
# Ruff linter/formatter cache
.ruff_cache/
# Coverage.py raw measurement data
.coverage
# Coverage.py HTML report output
htmlcov/

# Virtual Environments & Micromamba
# Common local Python virtual environment directories
.venv/
venv/
env/
# Forge environment/workspace directory
.forge/
# Micromamba environment and package cache
micromamba/

# ==========================================
# 2. PDKs & External Tool Checkouts
# ==========================================
# Process Design Kit root directories
pdks/
# Volare open-source PDK version manager files
volare/
# IHP Open PDK checkout
IHP-Open-PDK/
# SkyWater 130nm PDK variants
sky130*/
# GlobalFoundries 180nm MCU PDK variants
gf180mcu*/
# IHP SG13G2 BiCMOS PDK variants
sg13g2*/
# ASAP7 predictive 7nm PDK variants
asap7*/
# Vendored third-party repositories
third_party/
# Locally built or downloaded external EDA tools
external_tools/

# ==========================================
# 3. EDA Runs, Memory Compilers & Workspaces
# ==========================================
# Synthesis, place-and-route, and experiment run outputs
runs/
# Saved EDA flow or training checkpoints
checkpoints/
# General EDA working directories
work/
# Temporary scratch files
tmp/
# Simulation output directories
simulation/
# OpenRAM memory compiler temporary files
openram_temp/
# Generated SRAM macro directories
sram_*/
# GDSII layout build output directories
gds_build/
# gdsfactory cache directory
.gf_cache/

# ==========================================
# 4. Simulation & Waveforms (iverilog, verilator, gtkwave, ngspice)
# ==========================================
# Verilator C++ compilation output directory
obj_dir/
# Default compiler/simulator executable output
a.out
# Icarus Verilog compiled simulation files
*.vvp
# Value Change Dump waveform files
*.vcd
# Fast Signal Trace waveform files (GTKWave)
*.fst
# GTKWave LXT / LXT2 compressed waveform files
*.lxt
*.lxt2
# GHDL waveform files
*.ghw
# ngspice / SPICE raw binary simulation outputs
*.raw
# Transistor/voltage rule check log (e.g., 3.3V check)
b3v3check.log

# ==========================================
# 5. Layouts, Parasitics & DRC/LVS (OpenROAD, Magic, KLayout, Netgen, OpenRAM)
# ==========================================
# GDSII stream layout files (uncompressed and gzipped)
*.gds
*.gds.gz
# OASIS layout files
*.oas
# Design Exchange Format floorplan/placement/routing files (uncompressed and gzipped)
*.def
*.def.gz
# Standard Parasitic Exchange Format files (RC parasitics)
*.spef
# Standard Delay Format timing annotation files
*.sdf
# Magic extracted circuit and resistance files
*.ext
*.res.ext
# Magic/IRSIM alias and simulation files
*.al
*.sim
# SPICE netlists and simulation output logs
*.sp
*.spice.out
# Design Rule Check (DRC) report files
*.drc
# Layout Versus Schematic (LVS) report files and Netgen JSON outputs
*.lvs
*.lvs.json
# Netgen LVS comparison output file
comp.out
# Magic DRC report/output files
magic_drc*

# DREAMPlace / Bookshelf Intermediate Files
# Bookshelf netlist node definitions
*.nodes
# Bookshelf net connectivity definitions
*.nets
# Bookshelf cell placement coordinates
*.pl
# Bookshelf standard-cell row definitions
*.scl
# Bookshelf net/node weights
*.wts
# Bookshelf non-rectangular macro/block shapes
*.shapes
# Bookshelf routing information
*.route

# ==========================================
# 6. AI / RL Training & Optimization Logs
# ==========================================
# TensorBoard event log directories
tb_logs/
tensorboard/
# Weights & Biases local run logs
wandb/
# PyTorch model weights and checkpoints
*.pt
*.pth
# Open Neural Network Exchange (ONNX) model files
*.onnx
# Python pickle serialized objects
*.pkl
# Local SQLite database files
*.db
*.sqlite
*.sqlite3
# Compressed archive bundles
*.zip

# ==========================================
# 7. Keep Small Unit Test Fixtures Tracked!
# ==========================================
# Re-include the test fixtures directory and all files inside it
!tests/fixtures/
!tests/fixtures/**

# ==========================================
# 8. OS, IDEs & Notebooks
# ==========================================
# macOS folder metadata files
.DS_Store
# Windows Explorer thumbnail cache
Thumbs.db
# Visual Studio Code workspace settings
.vscode/
# JetBrains IDE (PyCharm/IntelliJ) project files
.idea/
# Jupyter Notebook autosave checkpoints
.ipynb_checkpoints/
# Local environment variables and secrets (never commit)
.env
